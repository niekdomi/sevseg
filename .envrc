# direnv config: make go / gopls / golangci-lint resolve TinyGo's `machine`
# package and apply the right build tags. Any tool launched from this directory
# inherits these, so it works regardless of editor.
#
# Requires direnv (https://direnv.net). Run `direnv allow` once after editing.
# Override the target with: TINYGO_TARGET=pico direnv reload

export TINYGO_TARGET="${TINYGO_TARGET:-arduino}"

_tinygo_info="$(tinygo info "$TINYGO_TARGET")"

# GOROOT: TinyGo's cached GOROOT, which contains src/machine. The path embeds a
# content hash, so it changes on TinyGo/Go upgrades -- derive it, don't hardcode.
export GOROOT="$(printf '%s\n' "$_tinygo_info" | awk -F': *' '/^cached GOROOT/ {print $2}')"

# GOFLAGS: the target's build tags, space-separated in `tinygo info`, joined
# with commas as `go`/gopls expect.
export GOFLAGS="-tags=$(printf '%s\n' "$_tinygo_info" | awk -F': *' '/^build tags/ {print $2}' | tr ' ' ',')"

unset _tinygo_info
